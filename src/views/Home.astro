---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Toolbar from '@/components/Toolbar.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Education from '@/components/Education.astro';
import Skills from '@/components/Skills.astro';
import Music from '@/components/Music.astro';
import Contact from '@/components/Contact.astro';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * Drop a portrait in /public/images/ and set its path here to replace the monogram,
 * e.g. const portrait = '/images/portrait.jpg';
 */
const portrait: string | undefined = undefined;
---

<BaseLayout locale={locale}>
  <Toolbar slot="header" locale={locale} />
  <Hero locale={locale} portrait={portrait} />
  <About locale={locale} />
  <Experience locale={locale} />
  <Education locale={locale} />
  <Skills locale={locale} />
  <Music locale={locale} />
  <Contact slot="footer" locale={locale} />
</BaseLayout>

<script>
  import '@/scripts/main';
</script>
