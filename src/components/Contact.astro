---
import Icon from './Icon.astro';
import { links, person } from '@/data/profile';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { shapePath } from '@/lib/shapes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const icons = {
  github: 'mdi:github',
  linkedin: 'mdi:linkedin',
  email: 'ms:mail-outline-rounded',
} as const;
const year = new Date().getFullYear();
const big = shapePath('sunny', 100);
---

<footer id="contact" class="contact" data-section aria-labelledby="contact-title">
  <svg class="bg-shape" viewBox="0 0 100 100" aria-hidden="true">
    <path d={big}></path>
  </svg>
  <div class="container inner">
    <h2 id="contact-title" class="title">
      {t('contact.title')}
    </h2>
    <p class="body">{t('contact.body')}</p>

    <ul role="list" class="links">
      {links.map((link) => (
        <li class:list={['link', `link-${link.id}`]}>
          <a
            href={link.href}
            {...(link.id !== 'email' ? { target: '_blank', rel: 'noopener me' } : {})}
          >
            <span class="icon-wrap">
              <Icon name={icons[link.id]} size={28} />
            </span>
            <span class="text">
              <span class="label">{link.id === 'email' ? t('contact.email') : link.label}</span>
              <span class="handle">
                {link.id === 'email' ? (
                  <>
                    {link.handle.split('@')[0]}
                    <wbr />@{link.handle.split('@')[1]}
                  </>
                ) : (
                  link.handle
                )}
              </span>
            </span>
            <Icon name="ms:north-east-rounded" size={28} class="arrow" />
            {link.id !== 'email' && <span class="sr-only">{t('a11y.newTab')}</span>}
          </a>
          {link.id === 'email' && (
            <button
              type="button"
              class="copy"
              data-copy={person.email}
              data-copied-label={t('contact.copied')}
              aria-label={t('contact.copy')}
            >
              <Icon name="ms:content-copy-outline-rounded" size={22} class="i-copy" />
              <Icon name="ms:check-rounded" size={22} class="i-done" />
              <span class="copy-label label-idle" aria-hidden="true">
                {t('contact.copy')}
              </span>
              <span class="copy-label label-done" aria-hidden="true">
                {t('contact.copied')}
              </span>
              <span class="copy-status" role="status" aria-live="polite" />
            </button>
          )}
        </li>
      ))}
    </ul>

    <p class="legal">
      <span>
        © {year} {person.firstName} {person.lastName}
      </span>
      <span>{t('footer.made')}</span>
    </p>
  </div>
</footer>

<style>
  .contact {
    position: relative;
    margin: var(--space-3);
    padding-block: var(--space-10) var(--space-6);
    border-radius: var(--corner-2xl);
    background: var(--primary);
    color: var(--on-primary);
    overflow: clip;
  }

  .bg-shape {
    position: absolute;
    width: min(70vw, 46rem);
    right: -12%;
    top: -18%;
    fill: color-mix(in oklab, var(--on-primary) 7%, var(--primary));
    rotate: 12deg;
    pointer-events: none;
  }

  .inner {
    position: relative;
  }

  .title {
    max-width: 14ch;
    font-size: var(--display-l);
    letter-spacing: -0.035em;
    --wght-final: 820;
    font-variation-settings: 'wght' 820;
  }

  .body {
    max-width: 48ch;
    margin-block-start: var(--space-5);
    font-size: var(--title-l);
    font-variation-settings: 'wght' 380;
  }

  .links {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-8);
    max-width: 52rem;
  }

  .link {
    display: flex;
    gap: var(--space-2);
  }

  .link a {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    min-height: 88px;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    border-radius: 46px; /* about half the rendered height: a real pill that animates smoothly */
    background: var(--on-primary);
    color: var(--primary);
    text-decoration: none;
    transition:
      border-radius var(--spring-fast-spatial-dur, 300ms) var(--spring-fast-spatial, ease),
      background-color 200ms linear;
  }

  .link a:hover {
    border-radius: var(--corner-xl);
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  .link a:focus-visible,
  .copy:focus-visible {
    outline-color: var(--on-primary);
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    transition: border-radius var(--spring-default-spatial-dur, 500ms)
      var(--spring-default-spatial, ease);
  }

  .link a:hover .icon-wrap {
    border-radius: var(--corner-l);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .label {
    font-size: var(--headline);
    line-height: 1.15;
    font-variation-settings: 'wght' 720;
    letter-spacing: -0.01em;
  }

  .handle {
    font-size: var(--body-m);
    font-variation-settings: 'wght' 450;
    overflow-wrap: normal;
  }

  .link :global(.arrow) {
    transition: translate var(--spring-fast-spatial-dur, 300ms) var(--spring-fast-spatial, ease);
  }

  .link a:hover :global(.arrow) {
    translate: 4px -4px;
  }

  .copy {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 88px;
    border: 0;
    border-radius: 46px;
    background: color-mix(in oklab, var(--on-primary) 16%, var(--primary));
    color: var(--on-primary);
    cursor: pointer;
    transition:
      border-radius var(--spring-fast-spatial-dur, 300ms) var(--spring-fast-spatial, ease),
      background-color 200ms linear;
  }

  .copy:hover {
    border-radius: var(--corner-xl);
    background: color-mix(in oklab, var(--on-primary) 24%, var(--primary));
  }

  .copy :global(.i-done),
  .copy[data-done] :global(.i-copy) {
    display: none;
  }

  /* Visible text label only in the stacked phone layout */
  .copy .copy-label {
    display: none;
  }

  .copy[data-done] :global(.i-done) {
    display: block;
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-9);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--corner-xl);
    background: color-mix(in oklab, var(--on-primary) 8%, var(--primary));
    font-size: var(--label-l);
    color: var(--on-primary);
  }

  @media (max-width: 720px) {
    .contact {
      margin: var(--space-2);
      padding-block: var(--space-8) calc(var(--space-9) + var(--space-4));
      border-radius: var(--corner-xl-plus);
    }

    .link a {
      gap: var(--space-3);
      min-height: 72px;
      padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
      border-radius: var(--corner-xl);
    }

    .icon-wrap {
      width: 48px;
      height: 48px;
    }

    .label {
      font-size: min(var(--title-l), 5.3vw);
      white-space: nowrap;
    }

    /* One line for the address, scaled down on the narrowest phones */
    .handle {
      white-space: nowrap;
      font-size: min(var(--body-m), 3.8vw);
    }

    /* Email + copy become a vertically connected pair: the address gets the full width */
    .link-email {
      flex-direction: column;
      gap: 2px;
    }

    .link-email a {
      border-radius: var(--corner-xl) var(--corner-xl) var(--corner-s) var(--corner-s);
    }

    .copy {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-2);
      width: auto;
      min-height: 52px;
      border-radius: var(--corner-s) var(--corner-s) var(--corner-xl) var(--corner-xl);
      font-size: var(--label-l);
      font-variation-settings: 'wght' 600;
    }

    .copy:hover {
      border-radius: var(--corner-s) var(--corner-s) var(--corner-xl) var(--corner-xl);
    }

    .copy .label-idle,
    .copy[data-done] .label-done {
      display: inline;
    }

    .copy[data-done] .label-idle {
      display: none;
    }
  }
</style>
