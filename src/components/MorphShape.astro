---
import { radiiToPath, sampleShape, type ShapeName } from '@/lib/shapes';

interface Props {
  shapes: ShapeName[];
  /** Accessible name of the button that advances the shape. */
  label: string;
  autoplay?: boolean;
  /** id of a button that pauses / resumes the loop */
  toggleId?: string;
  /** Optional image clipped by the shape (path under /public). */
  image?: { src: string; alt: string };
  tone?: 'primary' | 'tertiary' | 'secondary';
  scale?: number;
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}

const {
  shapes,
  label,
  autoplay = false,
  toggleId,
  image,
  tone = 'primary',
  scale = 0.92,
  class: className,
  ...rest
} = Astro.props;

const initial = radiiToPath(sampleShape(shapes[0] ?? 'circle'), 100, 0, scale);
const clipId = `clip-${Math.random().toString(36).slice(2, 9)}`;
---

<button
  type="button"
  class:list={['morph', `tone-${tone}`, className]}
  data-morph
  data-shapes={shapes.join(',')}
  data-autoplay={autoplay ? '' : undefined}
  data-toggle={toggleId}
  data-scale={scale}
  data-shape={shapes[0]}
  {...rest}
>
  <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={clipId}>
        <path data-morph-path d={initial}></path>
      </clipPath>
    </defs>
    <path class="morph-fill" data-morph-path d={initial}></path>
    {image ? (
      <image
        href={image.src}
        x="0"
        y="0"
        width="100"
        height="100"
        preserveAspectRatio="xMidYMid slice"
        clip-path={`url(#${clipId})`}
      />
    ) : (
      <g clip-path={`url(#${clipId})`} class="morph-inner">
        <slot />
      </g>
    )}
  </svg>
  <span class="sr-only">{image ? `${label}. ${image.alt}` : label}</span>
</button>

<style>
  .morph {
    --fill: var(--primary);
    --ink: var(--on-primary);
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .tone-tertiary {
    --fill: var(--tertiary);
    --ink: var(--on-tertiary);
  }

  .tone-secondary {
    --fill: var(--secondary-container);
    --ink: var(--on-secondary-container);
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .morph-fill {
    fill: var(--fill);
    transition: fill 300ms var(--ease-out);
  }

  /* Ring outside the shape, so it never sits on the shape's own colour */
  .morph:focus-visible {
    outline-offset: 4px;
    border-radius: 50%;
  }

  .morph-inner {
    color: var(--ink);
  }
</style>
