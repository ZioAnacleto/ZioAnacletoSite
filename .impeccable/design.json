      "css": ".ds-field{padding:1.5rem;border-radius:48px;background:var(--primary,#006b5c)}.ds-link{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.5rem;min-height:88px;padding:1rem 2rem 1rem 1rem;border-radius:999px;background:var(--on-primary,#fff);color:var(--primary,#006b5c);font-family:var(--font-sans);text-decoration:none;transition:border-radius var(--spring-fast-spatial-dur,300ms) var(--spring-fast-spatial,ease),background-color 200ms linear}.ds-link:hover{border-radius:28px;background:var(--primary-container,#9ef2dc);color:var(--on-primary-container,#00201a)}.ds-link:focus-visible{outline:3px solid var(--on-primary,#fff);outline-offset:3px}.ds-link-well{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--primary,#006b5c);color:var(--on-primary,#fff);transition:border-radius var(--spring-default-spatial-dur,500ms) var(--spring-default-spatial,ease)}.ds-link:hover .ds-link-well{border-radius:16px}.ds-link-text{display:grid}.ds-link-text b{font-size:clamp(1.5rem,1.2rem + 1.2vw,2rem);line-height:1.15;font-variation-settings:'wght' 720}.ds-link-text small{font-size:0.9375rem}.ds-link-arrow{transition:translate var(--spring-fast-spatial-dur,300ms) var(--spring-fast-spatial,ease)}.ds-link:hover .ds-link-arrow{translate:4px -4px}"
