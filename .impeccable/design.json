      "html": "<a class=\"ds-btn-filled\" href=\"#\">Read the story <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M11 4h2v12l5.5-5.5 1.42 1.42L12 19.84l-7.92-7.92L5.5 10.5 11 16z\"/></svg></a>",
      "css": ".ds-btn-filled{display:flex;width:fit-content;align-items:center;gap:var(--space-2,0.5rem);min-height:56px;padding-inline:2rem 1.5rem;border-radius:999px;background:var(--primary,#006b5c);color:var(--on-primary,#fff);font-family:var(--font-sans);font-size:1.125rem;font-variation-settings:'wght' 600;text-decoration:none;box-shadow:var(--elevation-1);transition:border-radius var(--spring-fast-spatial-dur,300ms) var(--spring-fast-spatial,ease),box-shadow 200ms linear}.ds-btn-filled:hover{border-radius:16px;box-shadow:var(--elevation-2)}.ds-btn-filled:active{border-radius:12px}.ds-btn-filled:focus-visible{outline:3px solid var(--primary,#006b5c);outline-offset:3px}"
    },
